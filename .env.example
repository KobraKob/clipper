# ---- The Provider Switch ----
PROVIDER=groq            # local | groq   (default for both STT and LLM)
# STT_PROVIDER=local     # optional per-stage override: local | groq
# LLM_PROVIDER=groq      # optional per-stage override: local | groq
FALLBACK_TO_LOCAL=false  # if true and LLM_PROVIDER=groq, fall back to Ollama when Groq errors out

# ---- Groq Configuration ----
GROQ_API_KEY=your_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b
STT_CHUNK_SECONDS=600    # 10 min chunks of 16 kHz mono WAV (~19 MB), under upload cap

# ---- Local Configuration ----
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto     # int8 on CPU, float16 on GPU
OLLAMA_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen2.5:3b-instruct
OLLAMA_STRONG_MODEL=qwen2.5:7b-instruct

# ---- Scoring Configuration ----
SHORTLIST=10             # How many candidates go to the strong LLM
MIN_CLIP_DURATION=20     # Minimum clip duration in seconds
MAX_CLIP_DURATION=60     # Maximum clip duration in seconds
