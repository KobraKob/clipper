# ---- The Provider Switch ----
PROVIDER=groq            # local | groq | openrouter   (default for both STT and LLM)
# STT_PROVIDER=local     # optional per-stage override: local | groq
# LLM_PROVIDER=groq      # optional per-stage override: local | groq | openrouter
FALLBACK_TO_LOCAL=true   # if true, fall back across providers (Groq -> OpenRouter -> Ollama) when errors occur

# ---- Groq Configuration ----
GROQ_API_KEY=your_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b
STT_CHUNK_SECONDS=180    # 3 min compressed MP3 chunks (~2 MB), prevents upload timeouts

# ---- OpenRouter Configuration (NVIDIA Nemotron 3 Ultra 550B) ----
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Local Configuration ----
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto     # int8 on CPU, float16 on GPU
OLLAMA_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen2.5:3b-instruct
OLLAMA_STRONG_MODEL=qwen2.5:7b-instruct

# ---- Scoring Configuration ----
SHORTLIST=10             # How many candidates go to the strong LLM
MIN_CLIP_DURATION=20     # Minimum clip duration in seconds
MAX_CLIP_DURATION=60     # Maximum clip duration in seconds

# ---- Source download quality ----
MIN_SOURCE_HEIGHT=1080   # keep trying other YouTube clients until at least this height is available
MAX_SOURCE_HEIGHT=2160   # never download more than this (4K = big files)
# YTDLP_COOKIES_FROM_BROWSER=chrome   # helps with age-gated / "sign in to confirm" videos
# YTDLP_COOKIES_FILE=cookies.txt

# ---- Output ----
OUT_WIDTH=1080
OUT_HEIGHT=1920
VIDEO_CRF=18             # lower = sharper/larger (16-20 is visually lossless for shorts)
LAYOUT=fill              # fill (full-screen, face-tracked) | fit_blur (whole frame on blurred background)

# ---- Captions: bold_pop | beast | one_word | highlight_box | neon | karaoke | clean ----
CAPTION_STYLE=bold_pop
# CAPTION_POSITION=bottom   # bottom | middle | top (default: the style's own)

# ---- SEO (title / description / hashtags per clip) ----
SEO_ENABLED=true
SEO_LANGUAGE=English
SEO_CREDIT_SOURCE=true   # add "Full video: <url>" to the description

# ---- Publishing (optional) ----
# YouTube: OAuth "Desktop app" client JSON from Google Cloud Console (YouTube Data API v3 enabled)
YOUTUBE_CLIENT_SECRETS=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
YOUTUBE_PRIVACY=private  # private | unlisted | public  (start with private and check the result)
YOUTUBE_CATEGORY_ID=22
# Instagram Reels: needs an Instagram Business/Creator account (Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_FLAVOR=facebook   # facebook = direct upload | instagram = needs INSTAGRAM_PUBLIC_BASE_URL
